# Modo gratis (provider "gratis"): el servidor usa esta key de OpenRouter con modelos :free
# fijados en lib/gratis.ts. Sin ella, el modo gratis responde 503. Nunca se envía al navegador.
OPENROUTER_API_KEY=

# Firma del token de cada debate (/api/debate/start lo emite; /api/debate lo exige en cada turno).
# Mínimo 32 bytes. Genéralo con:  openssl rand -base64 48
# Sin él, empezar un debate responde 503 (en `next dev` se usa uno efímero y se avisa en consola).
# Cambiarlo invalida los debates en curso.
DEBATE_TOKEN_SECRET=

# Límites del modo gratis y registro de turnos (Upstash Redis, plan gratis). Crea una base en
# https://console.upstash.com y copia sus dos valores REST. Sin ellos: en `next dev` se usa memoria
# (con aviso); en producción el modo gratis responde 503 y los modos con key propia siguen sin límite.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Debates gratis por IP y día natural en hora de Colombia (por defecto 3).
LIMITE_IP_DIARIO=
# Debates gratis en total al día, para todos (por defecto floor(1000 / 9 llamadas) = 111).
CUPO_GLOBAL_DIARIO=

# Cloudflare Turnstile (anti-bots al empezar un debate; se exige en TODOS los modos).
# Crea un widget gratis en https://dash.cloudflare.com/?to=/:account/turnstile (acción «iniciar-debate»,
# tipo «Managed») y copia sus dos claves. En Vercel ponlas como variables de entorno.
# Sin sitekey no se puede empezar un debate (salvo en `next dev`); sin secreto, /start responde 503
# (salvo en `next dev`, donde se omite con aviso).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: dominio que debe declarar el widget (p. ej. diablongo.vercel.app). Vacío = no se comprueba.
TURNSTILE_HOSTNAME=
# Claves de PRUEBA oficiales de Cloudflare ("siempre pasa"); sirven en local sin cuenta. Descomenta las dos:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
